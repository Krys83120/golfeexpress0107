generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  CLIENT
  PRO
  /// Compte employé créé par un Pro (le "patron") pour son équipe — voir
  /// model ProEmployee. Accès volontairement restreint : commandes en
  /// cours, notifications, impression des tickets. Jamais les données
  /// sensibles (finances détaillées, paramètres, abonnement...) — voir
  /// requireProOrEmployee() dans middleware/auth.ts.
  PRO_EMPLOYEE
  RIDER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum ProCategory {
  RESTAURANT
  BOULANGERIE
  BOUCHERIE
  EPICERIE
  PHARMACIE
  FLEURISTE
  LIBRAIRIE
  PARFUMERIE
  AUTRE
}

enum ProStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Motif de fermeture manuelle temporaire d'un Pro — distinct de ProStatus
/// (qui reflète la validation/modération du compte). Une fermeture manuelle
/// n'affecte jamais ProStatus ni les horaires enregistrés (OpeningHours) :
/// c'est un simple interrupteur, réversible en un clic, qui prime
/// temporairement sur le calcul ouvert/fermé habituel (voir
/// apps/api/src/lib/openingHours.ts).
enum ManualClosureReason {
  VACATION
  CLOSED
}

enum SubscriptionType {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum VehicleType {
  SCOOTER
  VOITURE
  VELO
  ELECTRIQUE
}

enum RiderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  RIDER_ASSIGNED
  PICKED_UP
  IN_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum EarningType {
  DELIVERY_FEE
  TIP
  BONUS
  INCENTIVE
  PENALTY
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER_STATUS
  NEW_ORDER
  RIDER_NEARBY
  PROMO
  SYSTEM
  PAYMENT
}

/// Catégories de réclamation/signalement sur une commande -- volontairement
/// une liste unique partagée par les 3 rôles qui peuvent créer un
/// OrderReport (Client, Livreur, Pro) plutôt que 3 enums séparés : chaque
/// app ne propose à l'utilisateur que le sous-ensemble pertinent pour son
/// rôle (voir apps/*/reportsApi.ts / ReportIssueScreen), mais l'admin
/// consulte tout au même endroit avec une seule liste de filtres.
enum OrderReportCategory {
  MISSING_ITEMS
  WRONG_ITEMS
  DAMAGED_OR_QUALITY
  LATE_DELIVERY
  DELIVERY_NOT_RECEIVED
  RIDER_BEHAVIOR
  CLIENT_UNREACHABLE
  ADDRESS_ISSUE
  PAYMENT_ISSUE
  STOCK_UNAVAILABLE
  TECHNICAL_ISSUE
  OTHER
}

enum OrderReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

/// Application source d'une visite trackée -- voir model AppVisit. WWW =
/// site vitrine (apps/www), les 3 autres = les apps authentifiées.
enum AppSource {
  WWW
  CLIENT
  PRO
  LIVREUR
}

// ==================== UTILISATEURS ====================

// NOTE IMPORTANT — Intégration Supabase Auth :
// `id` n'est PAS généré par Prisma (pas de @default(uuid())). Il est fourni
// explicitement et correspond toujours à `auth.users.id` côté Supabase.
// La ligne User est créée automatiquement par un trigger SQL Postgres
// (voir supabase/migrations) à chaque INSERT dans auth.users — donc Prisma
// ne doit JAMAIS créer de User directement via `prisma.user.create()` sans
// id explicite : la création du compte passe par Supabase Auth (signUp),
// le trigger se charge de la ligne User correspondante.
// `passwordHash` n'existe plus : Supabase Auth gère les mots de passe.
model User {
  id            String    @id
  email         String    @unique
  phone         String    @unique
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  avatar        String?
  role          UserRole  @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  clientProfile   Client?
  proProfile      Pro?
  riderProfile    Rider?
  adminProfile    Admin?
  /// Non-null uniquement pour un compte role=PRO_EMPLOYEE -- donne accès au
  /// Pro (boutique) pour lequel cet employé travaille. Voir model ProEmployee.
  employeeOfPro   ProEmployee?
  addresses       Address[]
  notifications   Notification[]
  passwordResetTokens PasswordResetToken[]
  orderReports    OrderReport[]
}

/// Compte employé rattaché à une boutique (Pro) -- créé uniquement par le
/// Pro "patron" lui-même (voir POST /api/pros/me/employees, qui utilise
/// supabaseAdmin pour créer le compte Auth au nom de l'employé). Un
/// employé a son propre login (email/mot de passe) mais un accès
/// volontairement restreint côté app Pro : commandes en cours,
/// notifications, impression des tickets -- jamais Finances/Paramètres/
/// Abonnement/Avis (voir apps/pro/src/App.tsx et Sidebar.tsx, qui masquent
/// ces sections dès que profile.isEmployee est vrai côté client, ET
/// requireProOrEmployee() qui refuse ces routes côté serveur -- la
/// restriction visuelle seule ne suffit jamais).
model ProEmployee {
  id        String   @id @default(uuid())
  proId     String   @map("pro_id")
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== RÉINITIALISATION DE MOT DE PASSE ====================

/// Système "mot de passe oublié" 100% maison (pas les emails automatiques
/// de Supabase Auth, pour garder un email à notre marque et cohérent avec
/// le reste — voir apps/api/src/lib/emails/authEmails.ts). On ne stocke
/// jamais le token en clair : uniquement son hash SHA-256, comme pour tout
/// système de token de réinitialisation sérieux.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== CLIENT ====================

model Client {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  fidelityPoints  Int      @default(0) @map("fidelity_points")
  referralCode    String   @unique @default(uuid()) @map("referral_code")
  /// Renseigné si ce client s'est inscrit via le code de parrainage d'un
  /// autre client — sert uniquement de traçabilité (les points de
  /// bienvenue sont déjà crédités à l'inscription, voir signup/route.ts).
  referredById    String?  @map("referred_by_id")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  reviews         Review[]
  productReviews  ProductReview[]
  referredBy      Client?  @relation("Referrals", fields: [referredById], references: [id])
  referrals       Client[] @relation("Referrals")
}

// ==================== PRO (COMMERÇANT) ====================

model Pro {
  id                String      @id @default(uuid())
  userId            String      @unique @map("user_id")
  businessName      String      @map("business_name")
  siret             String      @unique
  /// Vérifié automatiquement à la saisie via l'API publique Recherche
  /// d'Entreprises (recherche-entreprises.api.gouv.fr, gratuite, sans clé).
  siretVerified     Boolean     @default(false) @map("siret_verified")
  siretVerifiedAt   DateTime?   @map("siret_verified_at")
  /// Raison sociale — peut différer du nom commercial affiché aux clients (businessName).
  legalName         String?     @map("legal_name")
  legalForm         String?     @map("legal_form") // SARL, SAS, EI, auto-entrepreneur...
  vatNumber         String?     @map("vat_number") // TVA intracommunautaire, si applicable
  managerFirstName  String?     @map("manager_first_name")
  managerLastName   String?     @map("manager_last_name")
  description       String?
  category          ProCategory
  logo              String?
  coverImage        String?     @map("cover_image")
  phone             String
  emailContact      String      @map("email_contact")
  status            ProStatus   @default(PENDING)
  commissionRate    Decimal     @default(0.15) @map("commission_rate")
  subscriptionType  SubscriptionType @default(FREE) @map("subscription_type")
  subscriptionExpiry DateTime?  @map("subscription_expiry")
  /// Date du dernier email d'incitation à passer sur un pack payant, envoyé
  /// manuellement par un Admin depuis Commerçants (ajout du 25/09/2026,
  /// demande de Krys) -- affiché sur la fiche pour éviter de relancer deux
  /// fois le même commerçant sans s'en rendre compte. null = jamais envoyé.
  lastPremiumUpsellEmailAt DateTime? @map("last_premium_upsell_email_at")
  /// Date de la dernière relance "complétez votre dossier" envoyée
  /// manuellement par un Admin depuis Validations KYC (ajout du 26/09/2026,
  /// demande de Krys) -- pour les Pro inscrits mais qui n'ont jamais fini
  /// leur dossier (SIRET encore au format "PENDING-xxx" et/ou Kbis non
  /// uploadé, voir kbisUrl), donc jamais validables en l'état. null = jamais
  /// relancé.
  lastDossierReminderAt DateTime? @map("last_dossier_reminder_at")
  rating            Decimal?    @db.Decimal(2,1)
  ratingCount     Int      @default(0) @map("rating_count")

  /// Réseaux sociaux — simples liens optionnels affichés sur la fiche commerçant.
  instagramUrl      String?     @map("instagram_url")
  facebookUrl       String?     @map("facebook_url")
  tiktokUrl         String?     @map("tiktok_url")
  websiteUrl        String?     @map("website_url")

  /// Avis Google — identifiant de fiche "Google Business Profile" renseigné
  /// par le Pro (voir GoogleReviewsScreen côté Pro pour comment le trouver).
  /// La note/nb d'avis sont récupérés périodiquement via l'API Google
  /// Places (pas en direct à chaque affichage, pour éviter de payer un
  /// appel API à chaque visite) et mis en cache ici.
  googlePlaceId       String?   @map("google_place_id")
  googleRating        Decimal?  @db.Decimal(2,1) @map("google_rating")
  googleRatingCount   Int?      @map("google_rating_count")
  googleRatingSyncedAt DateTime? @map("google_rating_synced_at")

  /// Temps de préparation habituel (en minutes), réglable par le Pro dans
  /// ses paramètres — sert d'indication affichée sur la fiche commerçant
  /// côté Client (délai moyen avant qu'une commande soit prête). Distinct
  /// de Order.estimatedPrepMinutes, qui est la valeur choisie AU CAS PAR
  /// CAS par le Pro pour CHAQUE commande au moment de démarrer sa
  /// préparation (voir ProOrderCard.tsx côté Pro) — ce champ-ci ne sert
  /// que de valeur par défaut/indicative, jamais lu pour calculer le
  /// timing réel d'une commande en cours.
  defaultPrepTimeMinutes Int?   @default(15) @map("default_prep_time_minutes")

  /// Preuve de consentement CGU/CGV — date, version acceptée, et IP au
  /// moment de l'acceptation (utile en cas de litige).
  termsAcceptedAt   DateTime?   @map("terms_accepted_at")
  termsVersion      String?     @map("terms_version")
  termsAcceptedIp   String?     @map("terms_accepted_ip")

  /// Motif du dernier refus de validation KYC, transmis par email au Pro
  /// pour qu'il puisse corriger et soumettre à nouveau.
  rejectionReason   String?     @map("rejection_reason")

  /// Extrait Kbis — obligatoire pour la validation du compte, doit dater
  /// de moins de 3 mois (vérifié côté applicatif à partir de kbisUploadedAt,
  /// pas de champ "date d'émission" séparé pour rester simple : on se base
  /// sur la date d'upload, en informant clairement le Pro qu'il doit
  /// re-uploader un Kbis récent si le sien a plus de 3 mois).
  kbisUrl           String?     @map("kbis_url")
  kbisUploadedAt    DateTime?   @map("kbis_uploaded_at")

  /// Adresse principale de retrait (pickup)
  /// Référence la première adresse de la boutique.
  /// Stockée ici pour éviter une requête supplémentaire au checkout côté Client.
  pickupAddressId String?  @map("pickup_address_id")

  /// Stripe Connect (compte "Express") — permet au Pro de recevoir
  /// automatiquement sa part de chaque commande directement sur son propre
  /// compte bancaire, sans jamais transiter par notre base de données (ni
  /// IBAN stocké, ni virement manuel). Voir apps/api/src/lib/stripeConnect.ts.
  stripeAccountId          String?  @unique @map("stripe_account_id")
  /// true dès que Stripe a fini de vérifier l'identité + les coordonnées
  /// bancaires (mis à jour via le webhook account.updated).
  stripeChargesEnabled     Boolean  @default(false) @map("stripe_charges_enabled")
  /// true dès que Stripe peut réellement virer de l'argent sur le compte
  /// bancaire du Pro — c'est CE flag qui conditionne le déclenchement des
  /// virements automatiques (voir status/route.ts DELIVERED).
  stripePayoutsEnabled     Boolean  @default(false) @map("stripe_payouts_enabled")
  stripeOnboardingComplete Boolean  @default(false) @map("stripe_onboarding_complete")

  /// Stripe côté "Votre compte" (scope distinct de stripeAccountId ci-dessus,
  /// qui est un compte Connect Express pour RECEVOIR l'argent des commandes)
  /// — nécessaire ici pour FAIRE PAYER le Pro lui-même via un abonnement
  /// récurrent au pack partenaire choisi (voir GlobalSetting "partner_packs"
  /// et apps/api/src/lib/partnerPacks.ts).
  stripeCustomerId         String?  @unique @map("stripe_customer_id")
  /// Abonnement Stripe actif pour le pack payant en cours — null si FREE ou
  /// si l'abonnement a été résilié/n'a jamais été souscrit.
  stripeSubscriptionId     String?  @unique @map("stripe_subscription_id")
  /// Statut brut renvoyé par Stripe (active, past_due, canceled, unpaid...)
  /// — permet de distinguer un abonnement résilié proprement d'un paiement
  /// en échec côté UI Pro, sans réinterroger Stripe à chaque affichage.
  subscriptionStatus       String?  @map("subscription_status")
  /// Début de la période payée en cours (Stripe current_period_start) —
  /// "vous êtes abonné(e) depuis le..." côté UI Pro. Remis à jour à chaque
  /// renouvellement, contrairement à une date de première souscription qui
  /// resterait figée.
  subscriptionCurrentPeriodStart DateTime? @map("subscription_current_period_start")
  /// true si le Pro a demandé la résiliation mais que le mois déjà payé
  /// court encore — Stripe ne coupe l'accès qu'à la fin de la période
  /// (subscriptionExpiry), jamais immédiatement. Permet d'afficher
  /// "se termine le X" au lieu de "se renouvelle le X" côté UI Pro.
  subscriptionCancelAtPeriodEnd  Boolean   @default(false) @map("subscription_cancel_at_period_end")

  createdAt         DateTime    @default(now()) @map("created_at")

  /// Fermeture manuelle ("En vacances" / "Fermé exceptionnellement"),
  /// activable en un clic depuis les Réglages Pro SANS toucher aux horaires
  /// hebdomadaires ci-dessous (OpeningHours) — ceux-ci restent enregistrés
  /// tels quels et se réappliquent automatiquement dès la réouverture.
  /// Prime toujours sur OpeningHours dans le calcul ouvert/fermé exposé aux
  /// clients (voir lib/openingHours.ts) et bloque la création de nouvelles
  /// commandes côté serveur (voir orders/route.ts) tant qu'elle est active.
  isManuallyClosed     Boolean              @default(false) @map("is_manually_closed")
  manualClosureReason  ManualClosureReason? @map("manual_closure_reason")
  /// Date de retour prévue, optionnelle — affichée aux clients si renseignée.
  manualClosureUntil   DateTime?            @map("manual_closure_until")
  /// Message optionnel affiché aux clients (ex: "Fermeture pour travaux").
  manualClosureNote    String?              @map("manual_closure_note")

  /// Pause "test / développement" déclenchée UNIQUEMENT depuis l'admin
  /// (ADMIN/SUPER_ADMIN) — distincte de isManuallyClosed ci-dessus, que le
  /// Pro contrôle lui-même depuis ses Réglages : celle-ci, le Pro ne peut
  /// jamais la lever. Prime sur isManuallyClosed et les horaires dans le
  /// calcul ouvert/fermé (voir computeOpenStatus, lib/openingHours.ts) et
  /// bloque la création de commandes côté serveur (orders/route.ts) tant
  /// qu'elle est active — la boutique reste visible et consultable par les
  /// clients, seule la commande est bloquée. Ajoutée le 14/09/2026 pour
  /// éviter qu'un client ne passe commande chez un Pro tout juste validé,
  /// pendant que la plateforme est encore en développement/test.
  isPausedByAdmin      Boolean              @default(false) @map("is_paused_by_admin")
  /// Message optionnel affiché aux clients pendant la pause admin.
  adminPauseNote       String?              @map("admin_pause_note")

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses         Address[]
  products          Product[]
  openingHours      OpeningHours[]
  deliveryZones     DeliveryZone[]
  orders            Order[]
  /// Demandes "Colis Express" passées par ce Pro -- voir model ParcelOrder,
  /// table séparée de Order (19/09/2026).
  parcelOrders      ParcelOrder[]
  reviews           Review[]
  /// Comptes employés créés par ce Pro (voir model ProEmployee).
  employees         ProEmployee[]
  /// Ordre d'affichage + photo optionnelle des catégories de menu (voir
  /// model MenuCategory ci-dessous) -- absent pour une catégorie qui n'a
  /// jamais été personnalisée depuis l'admin (ordre alphabétique par défaut,
  /// pas de photo).
  menuCategories    MenuCategory[]
  /// Abonnements Web Push "nouvelle commande à préparer" (ajout du
  /// 22/09/2026, demande de Krys) -- voir ProPushSubscription ci-dessous.
  pushSubscriptions ProPushSubscription[]
}

// ==================== LIVREUR (RIDER) ====================

enum RiderProfessionalStatus {
  AUTO_ENTREPRENEUR
  SALARIE
  INDEPENDANT
  AUTRE
}

model Rider {
  id              String       @id @default(uuid())
  userId          String       @unique @map("user_id")
  birthDate       DateTime?    @map("birth_date")
  street          String?
  zipCode         String?      @map("zip_code")
  city            String?
  /// Photo de profil — affichée publiquement au client/commerçant pendant
  /// une livraison. Bien distincte de verificationSelfieUrl ci-dessous.
  profilePhotoUrl String?      @map("profile_photo_url")
  /// Selfie de vérification d'identité — usage interne uniquement (contrôle
  /// KYC), ne doit JAMAIS être affiché publiquement ni traité comme une
  /// simple photo de profil (voir considérations RGPD : accès restreint,
  /// durée de conservation limitée à la durée strictement nécessaire à la
  /// vérification + obligations légales, jamais réutilisé à d'autres fins).
  verificationSelfieUrl String? @map("verification_selfie_url")
  professionalStatus RiderProfessionalStatus? @map("professional_status")
  /// SIRET du livreur lui-même, uniquement s'il exerce en indépendant
  /// (auto-entrepreneur...) — distinct du SIRET d'un Pro (commerçant).
  siret           String?
  insuranceProvider String?    @map("insurance_provider")
  insurancePolicyNumber String? @map("insurance_policy_number")
  vehicleType     VehicleType  @map("vehicle_type")
  vehiclePlate    String?      @map("vehicle_plate")
  licenseNumber   String?      @map("license_number")
  idCardFront     String       @map("id_card_front")
  idCardBack      String       @map("id_card_back")
  /// Date de la dernière relance "complétez votre dossier" envoyée
  /// manuellement par un Admin depuis Validations KYC (ajout du 26/09/2026,
  /// demande de Krys) -- pour les Livreurs inscrits mais qui n'ont jamais
  /// fini leur dossier (idCardFront/idCardBack/iban encore vides, voir
  /// signup/route.ts). null = jamais relancé.
  lastDossierReminderAt DateTime? @map("last_dossier_reminder_at")
  /// @deprecated Conservé pour compatibilité avec l'ancien système de
  /// retrait manuel (voir Withdrawal), mais plus utilisé pour les nouveaux
  /// virements dès que stripePayoutsEnabled est true — voir stripeAccountId
  /// ci-dessous, qui est désormais la vraie source de vérité bancaire.
  iban            String
  status          RiderStatus  @default(PENDING)

  /// Stripe Connect (compte "Express") — voir Pro.stripeAccountId pour le
  /// détail du fonctionnement, identique ici pour les livreurs.
  stripeAccountId          String?  @unique @map("stripe_account_id")
  stripeChargesEnabled     Boolean  @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled     Boolean  @default(false) @map("stripe_payouts_enabled")
  stripeOnboardingComplete Boolean  @default(false) @map("stripe_onboarding_complete")
  isOnline        Boolean      @default(false) @map("is_online")
  currentLat      Decimal?     @db.Decimal(10,8) @map("current_lat")
  currentLng      Decimal?     @db.Decimal(11,8) @map("current_lng")
  currentLocationUpdatedAt DateTime? @map("current_location_updated_at")
  /// Délai (en minutes) sans mise à jour de position au-delà duquel ce
  /// livreur est automatiquement repassé hors ligne s'il a oublié de se
  /// déconnecter -- réglable par le livreur lui-même depuis son profil
  /// (voir apps/livreur/src/screens/RiderProfileScreen.tsx), n'a d'effet
  /// que si l'admin a activé le mécanisme globalement (voir
  /// capacitySettings.ts -- isStaleRiderAutoOfflineEnabled). Par défaut 1h
  /// (échange produit du 23/08/2026 -- était fixé à 30 min pour tout le
  /// monde, désormais configurable, valeur par défaut portée à 60).
  autoOfflineTimeoutMinutes Int @default(60) @map("auto_offline_timeout_minutes")
  /// Notifications "nouvelle commande à proximité" (ajout du 20/09/2026,
  /// demande explicite de Krys) -- réglable par le livreur lui-même depuis
  /// son profil, indépendamment du fait qu'il ait ou non accepté
  /// l'autorisation navigateur (Web Push). true par défaut : un livreur qui
  /// vient d'activer les notifications dans son navigateur s'attend à les
  /// recevoir tout de suite, pas à devoir cocher un 2e interrupteur.
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  rating          Decimal?     @db.Decimal(2,1)
  ratingCount     Int          @default(0) @map("rating_count")
  totalDeliveries Int          @default(0) @map("total_deliveries")
  totalEarnings   Decimal      @default(0) @db.Decimal(10,2) @map("total_earnings")
  balance         Decimal      @default(0) @db.Decimal(10,2)

  /// Preuve de consentement CGU/CGV — voir Pro.termsAcceptedAt.
  termsAcceptedAt   DateTime?   @map("terms_accepted_at")
  termsVersion      String?     @map("terms_version")
  termsAcceptedIp   String?     @map("terms_accepted_ip")

  /// Motif du dernier refus de validation KYC — voir Pro.rejectionReason.
  rejectionReason   String?     @map("rejection_reason")

  createdAt       DateTime     @default(now()) @map("created_at")
  
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  /// Courses "Colis Express" acceptées par ce livreur -- voir model
  /// ParcelOrder, table séparée de Order (19/09/2026).
  parcelOrders    ParcelOrder[]
  earnings        Earning[]
  withdrawals     Withdrawal[]
  reviews         Review[]
  /// Abonnements Web Push (un par navigateur/appareil sur lequel le livreur
  /// a activé les notifications, voir RiderPushSubscription ci-dessous).
  pushSubscriptions RiderPushSubscription[]
}

/// Abonnement Web Push d'un livreur sur UN navigateur/appareil donné (ajout
/// du 20/09/2026, notifications "nouvelle commande à proximité"). Table
/// séparée plutôt que des colonnes sur Rider : un même livreur peut ouvrir
/// livreur.doyougeckoo.fr depuis plusieurs téléphones/navigateurs, chacun
/// avec son propre `endpoint` (fourni par le navigateur, unique par
/// abonnement) -- on notifie alors tous les abonnements actifs de ce
/// livreur. `onDelete: Cascade` : supprimé automatiquement si le compte
/// livreur est supprimé, jamais laissé orphelin.
model RiderPushSubscription {
  id        String   @id @default(uuid())
  riderId   String   @map("rider_id")
  /// URL unique fournie par le navigateur pour ce couple (livreur,
  /// appareil, navigateur) -- sert d'identifiant naturel : un même
  /// navigateur qui se réabonne (ex: permissions réinitialisées) obtient un
  /// nouvel endpoint, l'ancien devient caduc et sera nettoyé au prochain
  /// envoi en échec (voir webPush.ts).
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@map("rider_push_subscriptions")
}

/// Abonnements Web Push "nouvelle commande à préparer" côté Pro (ajout du
/// 22/09/2026, demande de Krys : "imaginons le pro a Uber et doyougeckoo en
/// même temps... avant de nous choisir car on est local et moins cher" --
/// être notifié même appli fermée est un vrai argument concurrentiel).
/// Structure identique à RiderPushSubscription ci-dessus, mais rattachée à
/// `proId` (la BOUTIQUE) et non à un utilisateur précis : le patron ET ses
/// employés (voir ProEmployee) peuvent chacun s'abonner depuis leur propre
/// appareil, et TOUS les abonnements actifs de la boutique reçoivent la
/// notification (voir webPush.ts, sendPushToPro, et
/// apps/api/src/app/api/pros/push-subscription/route.ts qui résout proId
/// depuis requireProOrEmployee -- patron ou employé, indifféremment).
/// `onDelete: Cascade` : supprimé automatiquement si la boutique est
/// supprimée, jamais laissé orphelin.
model ProPushSubscription {
  id        String   @id @default(uuid())
  proId     String   @map("pro_id")
  /// Voir le commentaire équivalent sur RiderPushSubscription.endpoint.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  pro       Pro      @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
  @@map("pro_push_subscriptions")
}

// ==================== ADRESSES ====================

model Address {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  proId       String?  @map("pro_id")
  label       String
  street      String
  complement  String?
  zipCode     String   @map("zip_code")
  city        String
  lat         Decimal  @db.Decimal(10,8)
  lng         Decimal  @db.Decimal(11,8)
  isDefault   Boolean  @default(false) @map("is_default")
  
  user        User?    @relation(fields: [userId], references: [id])
  pro         Pro?     @relation(fields: [proId], references: [id])
  ordersFrom  Order[]  @relation("OrderFromAddress")
  ordersTo    Order[]  @relation("OrderToAddress")
  /// Colis Express -- voir model ParcelOrder (19/09/2026).
  parcelOrdersFrom ParcelOrder[] @relation("ParcelFromAddress")
  parcelOrdersTo   ParcelOrder[] @relation("ParcelToAddress")
}

// ==================== ZONES DE LIVRAISON PRO ====================

model DeliveryZone {
  id          String   @id @default(uuid())
  proId       String   @map("pro_id")
  name        String
  geoJson     Json     @map("geo_json")
  minOrder    Decimal? @db.Decimal(6,2) @map("min_order")
  deliveryFee Decimal  @db.Decimal(4,2) @map("delivery_fee")
  estimatedTime Int    @map("estimated_time")
  isActive    Boolean  @default(true) @map("is_active")
  
  pro         Pro      @relation(fields: [proId], references: [id])
}

// ==================== PRODUITS ====================

model Product {
  id          String   @id @default(uuid())
  proId       String   @map("pro_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(8,2)
  image       String?
  /// Photos supplémentaires (galerie), au-delà de `image` la photo principale
  additionalImages String[] @default([]) @map("additional_images")
  category    String
  /// Position de ce produit au sein de sa catégorie (vignette "sous-catégorie"
  /// côté app Client), réglable par glisser-déposer depuis l'admin (voir
  /// PUT .../products/reorder). 0 par défaut pour tout produit jamais
  /// réordonné manuellement -- l'ordre affiché retombe alors sur celui
  /// renvoyé par l'API (voir orderBy dans GET /api/pros/[proId]/products),
  /// jamais laissé à l'ordre implicite de la base (voir la même remarque
  /// sur ProductOption.sortOrder plus bas dans ce fichier).
  sortOrder   Int      @default(0) @map("sort_order")
  isAvailable Boolean  @default(true) @map("is_available")
  isFeatured  Boolean  @default(false) @map("is_featured")
  /// Rendu non-disponible temporairement (rupture, etc.) jusqu'à cette date
  /// incluse -- null tant que le produit n'est pas dans ce cas. Utilisé avec
  /// isAvailable=false : si renseigné, un job Cron quotidien remet
  /// automatiquement isAvailable=true et ce champ à null dès que la date est
  /// dépassée (voir /api/cron/reset-product-availability). Si isAvailable=false
  /// et ce champ reste null, l'indisponibilité est manuelle et permanente
  /// (jusqu'à ce que le Pro recoche "Disponible" lui-même).
  unavailableUntil DateTime? @map("unavailable_until")
  /// true = le client voit un champ "Instructions spécifiques" (texte libre)
  /// pour CE produit lors de l'ajout au panier, stocké par ligne de panier
  /// sur OrderItem.specialInstructions -- voir ProductOptionsModal.tsx côté
  /// Client. Réglable par le Pro depuis le bas de la fiche produit, au
  /// niveau des options (ProductFormModal.tsx).
  allowSpecialInstructions Boolean @default(false) @map("allow_special_instructions")
  /// true = un message d'info ("Des frais supplémentaires peuvent être
  /// appliqués pour cette option") s'affiche au client lors du choix des
  /// options de CE produit -- un seul réglage pour tout le produit, pas par
  /// groupe d'options. Réglable par le Pro au même endroit que ci-dessus.
  hasExtraFeeNotice        Boolean @default(false) @map("has_extra_fee_notice")
  /// Moyenne des avis ProductReview visibles pour ce produit -- recalculee a
  /// chaque nouvel avis (voir POST /api/orders/[orderId]/review), affichee
  /// sur la fiche produit (ProductOptionsModal cote app Client).
  rating      Decimal? @db.Decimal(2,1)
  ratingCount Int      @default(0) @map("rating_count")
  options     ProductOption[]

  pro            Pro             @relation(fields: [proId], references: [id])
  orderItems     OrderItem[]
  productReviews ProductReview[]
}

/// Métadonnées d'affichage d'une catégorie de menu (vignette catégorie côté
/// app Client) -- ordre + photo optionnelle, réglables depuis l'admin
/// (AdminCategoryManagerModal.tsx). Délibérément SANS relation vers Product
/// (pas de categoryId en clé étrangère) : une catégorie n'est qu'une valeur
/// de Product.category (simple chaîne, voir plus haut), donc une ligne ici
/// n'existe que pour les catégories déjà personnalisées -- une catégorie
/// nouvellement importée (via CSV) n'a pas encore de ligne et retombe sur un
/// ordre alphabétique + un emoji par défaut côté Client, jusqu'à ce que
/// l'admin la personnalise. Ce choix évite tout risque sur le modèle
/// Product existant (déjà utilisé par les commandes/le panier en prod).
model MenuCategory {
  id        String   @id @default(uuid())
  proId     String   @map("pro_id")
  /// Doit correspondre EXACTEMENT (casse comprise) à Product.category --
  /// renommer une catégorie (voir .../products/rename-category) doit
  /// répercuter ce renommage ici pour ne pas perdre l'ordre/la photo déjà
  /// réglés (voir la route de renommage, mise à jour en conséquence).
  name      String
  /// Photo de catégorie, uploadée depuis l'admin -- null tant qu'aucune
  /// n'a été choisie (repli sur la photo du premier produit avec image,
  /// puis sur un emoji générique côté Client, voir ProDetailScreen.tsx).
  image     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pro Pro @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@unique([proId, name])
  @@map("menu_categories")
}

model ProductOption {
  id          String        @id @default(uuid())
  productId   String        @map("product_id")
  name        String
  isRequired  Boolean       @default(false) @map("is_required")
  isMultiple  Boolean       @default(false) @map("is_multiple")
  /// Nombre maximum de choix sélectionnables dans ce groupe, uniquement
  /// pertinent quand isMultiple=true (ex: "3 max" pour un groupe "Extra
  /// Protéines" à 5 choix). null = pas de limite. Réglé par le Pro dans
  /// ProductFormModal.tsx, appliqué côté Client (ProductOptionsModal.tsx,
  /// bloque une sélection supplémentaire une fois la limite atteinte) ET
  /// revalidé côté serveur à la création de commande (orders/route.ts) --
  /// jamais fait confiance uniquement au blocage client.
  maxChoices  Int?          @map("max_choices")
  /// Position de ce groupe dans la liste telle que configurée par le Pro
  /// (ProductFormModal.tsx, ordre des groupes à l'écran) -- sans ce champ,
  /// l'ordre renvoyé par une requête Prisma/Postgres sans `orderBy` n'est
  /// PAS garanti stable dans le temps (dépend du plan d'exécution, pas de
  /// l'ordre de création), ce qui mélangeait l'ordre des groupes sur le
  /// ticket de préparation (printLabel.ts) et dans ProductOptionsModal.tsx
  /// côté Client. Réécrit intégralement (0, 1, 2...) à chaque sauvegarde
  /// des options par le Pro (PUT /api/pros/me/products/[productId]/options,
  /// qui supprime puis recrée tous les groupes -- voir ce fichier). TOUTE
  /// requête qui lit ProductOption doit trier par ce champ (orderBy:
  /// {sortOrder: "asc"}), jamais laisser l'ordre implicite de la base.
  sortOrder   Int           @default(0) @map("sort_order")
  /// Groupe CONDITIONNEL : si renseigné, ce groupe n'est affiché au client
  /// (et son "isRequired" éventuel n'est appliqué) que si ce choix précis
  /// (dans un AUTRE groupe, forcément défini avant celui-ci -- voir la
  /// validation dans updateProductOptionsSchema) est actuellement
  /// sélectionné. Ex: groupe "Formule" (Seul / En Menu), puis groupes
  /// "Boisson"/"Accompagnement" qui dépendent du choix "En Menu" -- ils
  /// n'apparaissent et ne deviennent obligatoires que si le client a
  /// choisi "En Menu". null = groupe inconditionnel (comportement normal,
  /// toujours affiché), comme avant l'ajout de ce champ.
  ///
  /// Référencé par id (OptionChoice.id), mais ce id change à CHAQUE
  /// sauvegarde des options par le Pro (PUT .../options supprime puis
  /// recrée systématiquement tous les groupes/choix) -- le payload envoyé
  /// par ProductFormModal.tsx référence donc la dépendance par POSITION
  /// (groupIndex/choiceIndex dans le tableau soumis), résolue vers le vrai
  /// id en base seulement après création (voir options/route.ts). Ne
  /// jamais essayer d'écrire ce champ directement depuis une position sans
  /// passer par cette résolution.
  ///
  /// onDelete: SetNull (pas Restrict) -- indispensable : la route PUT
  /// options supprime tous les OptionChoice existants avant de tout
  /// recréer, à CHAQUE sauvegarde ; avec Restrict, ne serait-ce qu'une
  /// dépendance existante ferait échouer cette suppression en boucle.
  dependsOnChoiceId String?       @map("depends_on_choice_id")
  dependsOnChoice   OptionChoice? @relation("OptionDependency", fields: [dependsOnChoiceId], references: [id], onDelete: SetNull)
  choices     OptionChoice[]

  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model OptionChoice {
  id            String        @id @default(uuid())
  optionId      String        @map("option_id")
  name          String
  priceModifier Decimal       @default(0) @db.Decimal(6,2) @map("price_modifier")
  /// Même principe que Product.isAvailable / unavailableUntil (rupture d'un
  /// choix précis dans un groupe, ex: "plus de mâche" dans "La Base") --
  /// voir ProductFormModal.tsx (réglage par choix) et le job Cron quotidien
  /// /api/cron/reset-product-availability qui remet aussi ces choix-ci
  /// disponibles une fois unavailableUntil dépassée.
  isAvailable       Boolean   @default(true) @map("is_available")
  unavailableUntil  DateTime? @map("unavailable_until")
  /// true = le client peut ajouter CE choix plusieurs fois sur la même
  /// ligne (ex: "Bacon" x4) plutôt qu'une seule fois -- activé par le Pro
  /// choix par choix (pas par groupe entier), voir ProductFormModal.tsx
  /// (réglage, uniquement affiché quand ProductOption.isMultiple=true) et
  /// ProductOptionsModal.tsx côté Client (stepper +/- à la place de la case
  /// à cocher simple). La quantité est encodée en répétant le nom du choix
  /// dans la chaîne CSV envoyée pour ce groupe (ex: "Bacon, Bacon, Bacon,
  /// Bacon") -- computeOptionsSurcharge (orders/route.ts) somme déjà le
  /// supplément par occurrence, aucun changement nécessaire à ce calcul.
  /// Revalidé côté serveur par assertQuantifiableChoices (orders/route.ts).
  allowMultipleQty  Boolean   @default(false) @map("allow_multiple_qty")
  /// Position de ce choix dans son groupe, même principe et même raison que
  /// ProductOption.sortOrder ci-dessus (ordre non garanti sans ce champ).
  /// TOUTE requête qui lit OptionChoice doit trier par ce champ.
  sortOrder         Int       @default(0) @map("sort_order")

  option        ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// Côté inverse de ProductOption.dependsOnChoiceId -- les groupes
  /// conditionnels qui n'apparaissent que si CE choix précis est
  /// sélectionné. Jamais lu directement dans le code applicatif (la
  /// résolution se fait plutôt via ProductOption.dependsOnChoiceId), mais
  /// requis par Prisma pour une relation nommée entre deux mêmes modèles.
  dependentOptions ProductOption[] @relation("OptionDependency")
}

// ==================== COMMANDES ====================

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  clientId        String      @map("client_id")
  proId           String      @map("pro_id")
  riderId         String?     @map("rider_id")
  fromAddressId   String      @map("from_address_id")
  toAddressId     String      @map("to_address_id")
  
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")

  /// Commande de test créée/marquée depuis l'Admin (demande explicite de
  /// Krys, 22/09/2026) -- permet de faire avancer manuellement une commande
  /// à travers tout le cycle de statuts (payée -> préparation -> prête ->
  /// livraison -> terminée) SANS jamais toucher au circuit réel : voir
  /// apps/api/src/app/api/admin/orders/[orderId]/{mark-test,test-transition}/
  /// route.ts, qui n'appellent jamais Stripe, n'envoient aucun email et ne
  /// créditent aucun gain Pro/Rider ni point de fidélité pour ces commandes.
  /// Ne peut être activé QUE tant que la commande est encore PENDING/impayée
  /// (voir mark-test/route.ts) -- impossible de "transformer" une vraie
  /// commande déjà engagée. Exclu des recettes/CA (admin/stats,
  /// admin/finances) pour ne jamais fausser les chiffres réels.
  isTest          Boolean     @default(false) @map("is_test")

  subtotal        Decimal     @db.Decimal(10,2)
  deliveryFee     Decimal     @db.Decimal(6,2) @map("delivery_fee")
  serviceFee      Decimal     @db.Decimal(6,2) @map("service_fee")
  discount        Decimal     @default(0) @db.Decimal(10,2)
  total           Decimal     @db.Decimal(10,2)
  
  proEarnings     Decimal     @db.Decimal(10,2) @map("pro_earnings")
  riderEarnings   Decimal     @db.Decimal(6,2) @map("rider_earnings")
  platformEarnings Decimal    @db.Decimal(10,2) @map("platform_earnings")

  /// Id du virement Stripe Connect (transfer) envoyé au Pro/Rider pour
  /// cette commande, rempli uniquement si leur compte Stripe était prêt à
  /// recevoir des paiements au moment de la livraison (voir status/route.ts).
  /// null = pas encore transféré (soit compte pas encore configuré, soit
  /// le transfert a échoué — jamais bloquant pour la livraison elle-même).
  proTransferId   String?     @map("pro_transfer_id")
  riderTransferId String?     @map("rider_transfer_id")
  
  placedAt        DateTime    @default(now()) @map("placed_at")
  acceptedAt      DateTime?   @map("accepted_at")
  /// Horodatage dédié au moment où LE LIVREUR accepte/prend en charge la
  /// commande (transition -> RIDER_ASSIGNED, voir orders/[orderId]/accept/
  /// route.ts) -- distinct de acceptedAt ci-dessus qui ne reflète que la
  /// confirmation du PRO (transition -> CONFIRMED, voir status/route.ts) et
  /// ne bougeait donc jamais à l'acceptation du livreur. Sert de point de
  /// départ au chrono de livraison (app Livreur + dashboard Admin, voir
  /// CurrentDeliveryCard.tsx / ActiveDeliveriesCard.tsx).
  riderAssignedAt DateTime?   @map("rider_assigned_at")
  estimatedPrepMinutes Int?   @map("estimated_prep_minutes")
  preparingStartedAt  DateTime? @map("preparing_started_at")
  readyAt         DateTime?   @map("ready_at")
  pickedUpAt      DateTime?   @map("picked_up_at")
  deliveredAt     DateTime?   @map("delivered_at")
  estimatedDelivery DateTime? @map("estimated_delivery")
  /// true des qu'une penalite de retard a ete appliquee pour cette
  /// commande (voir orders/[orderId]/status/route.ts, transition
  /// DELIVERED) -- evite d'appliquer la penalite deux fois si cette route
  /// etait rappelee par erreur sur une commande deja livree.
  latePenaltyApplied Boolean  @default(false) @map("late_penalty_applied")
  /// true dès qu'une alerte admin "aucun livreur" a été envoyée pour cette
  /// commande (voir cron/capacity-sweep/route.ts) -- évite de renvoyer le
  /// même email à chaque passage du cron tant que la commande reste
  /// bloquée ; jamais remis à false ensuite (même si un livreur finit par
  /// accepter, ce n'est qu'un flag anti-doublon, pas un état métier).
  riderSearchAlertSent Boolean @default(false) @map("rider_search_alert_sent")
  /// Horodatage du 1er envoi de notification "commande à proximité" aux
  /// livreurs pour cette commande (ajout du 20/09/2026) -- évite de
  /// renotifier à chaque appel de GET /api/riders/me/available-orders tant
  /// que la commande reste visible dans la fenêtre de recherche (voir
  /// riderSearchWindow.ts). null = pas encore notifiée. Jamais réinitialisé
  /// ensuite, même si la commande change de statut -- simple flag anti-
  /// doublon, comme riderSearchAlertSent ci-dessus.
  riderNotifiedAt DateTime? @map("rider_notified_at")

  clientNote      String?     @map("client_note")
  deliveryPhoto   String?     @map("delivery_photo")
  deliveryCode    String?     @map("delivery_code")
  rating          Int?
  review          String?

  /// Marque et 4 derniers chiffres de la carte utilisée pour le paiement
  /// Stripe de cette commande (ex: "visa", "4242") -- renseignés uniquement
  /// une fois le paiement capturé avec succès (voir webhooks/stripe/
  /// route.ts, payment_intent.succeeded), jamais réinitialisés à null par
  /// la suite. Affichés sur le ticket de préparation (voir printLabel.ts).
  cardBrand       String?     @map("card_brand")
  cardLast4       String?     @map("card_last_4")

  /// Id du PaymentIntent Stripe de cette commande (ajout du 25/09/2026,
  /// même principe que ParcelOrder.stripePaymentIntentId) -- posé dès la
  /// création du PaymentIntent (voir orders/[orderId]/payment-intent/
  /// route.ts), PAS seulement au moment où le webhook confirme le paiement,
  /// pour être disponible immédiatement si la commande est annulée avant
  /// même que le webhook Stripe soit passé. Indispensable pour pouvoir
  /// déclencher un remboursement automatique à l'annulation (voir
  /// orders/[orderId]/status/route.ts et
  /// admin/orders/[orderId]/force-cancel/route.ts) -- sans cette référence,
  /// impossible de savoir QUEL paiement Stripe rembourser. Reste null pour
  /// toutes les commandes créées avant ce déploiement (remboursement de
  /// celles-ci : manuel depuis le Dashboard Stripe, comme aujourd'hui).
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  /// Id du remboursement Stripe (Refund) une fois qu'un remboursement
  /// automatique a réussi (ajout du 25/09/2026) -- traçabilité uniquement
  /// (affichage futur côté Admin), ne conditionne aucune logique métier :
  /// c'est paymentStatus qui reste la source de vérité (REFUNDED).
  stripeRefundId  String?     @map("stripe_refund_id")

  client          Client      @relation(fields: [clientId], references: [id])
  pro             Pro         @relation(fields: [proId], references: [id])
  rider           Rider?      @relation(fields: [riderId], references: [id])
  fromAddress     Address     @relation("OrderFromAddress", fields: [fromAddressId], references: [id])
  toAddress       Address     @relation("OrderToAddress", fields: [toAddressId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  trackingEvents  TrackingEvent[]
  /// Nomme "reviewRecord" (pas "review") pour ne pas entrer en collision
  /// avec le champ historique Order.review (simple texte libre, conserve
  /// tel quel) -- reviewRecord est l'avis structure sur commercant/livreur/
  /// plateforme (voir model Review), cree seulement si au moins une de ces
  /// 3 cibles est notee. productReviews couvre les avis sur les produits
  /// achetes, entierement independants (voir model ProductReview).
  reviewRecord    Review?
  productReviews  ProductReview[]
  reports         OrderReport[]

  // Ajoutés le 23/09/2026 (ralentissements constatés en test réel
  // client+pro+livreur simultané) -- Order est la table la plus interrogée
  // de toute l'appli, et jusqu'ici AUCUN index n'existait dessus en dehors
  // de id/orderNumber : chaque requête `WHERE proId = ...` /
  // `WHERE riderId = ...` / `WHERE clientId = ...` (voir orders/route.ts,
  // filtrée par rôle -- Pro pollé toutes les 15s, Livreur toutes les
  // 10-20s) forçait un scan complet de la table. Les 3 index ci-dessous
  // couvrent les 3 rôles (Pro/Employee, Client, Rider) combinés avec le tri
  // `orderBy: placedAt desc` déjà utilisé par cette même route -- un index
  // composite (colonne de filtre + placedAt) sert directement le filtre ET
  // le tri en une seule passe, sans étape de tri séparée.
  @@index([proId, placedAt])
  @@index([clientId, placedAt])
  @@index([riderId, placedAt])
  // Couvre spécifiquement GET /api/riders/me/available-orders (riderId
  // IS NULL, status IN (READY, PREPARING), orderBy placedAt asc) --
  // interrogée par CHAQUE livreur en ligne toutes les 10 secondes.
  @@index([riderId, status, placedAt])
  // Ajouté le 23/09/2026 (suite des lenteurs testées en réel) -- couvre
  // spécifiquement cancelStalePendingOrders() dans orders/route.ts
  // (WHERE status = PENDING AND placedAt < ...), exécutée à CHAQUE appel de
  // GET /api/orders, par TOUS les rôles confondus (Client/Pro/Livreur/
  // Admin) -- sans cet index, cette vérification scannait la table Order
  // en entier à chaque chargement de liste de commandes, quel que soit le
  // rôle qui la déclenche.
  @@index([status, placedAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @db.Decimal(8,2) @map("unit_price")
  totalPrice  Decimal  @db.Decimal(10,2) @map("total_price")
  options     Json?
  /// Instruction libre du client pour CETTE ligne précisément (ex: "bien
  /// cuit", "sans oignon") -- distinct de Order.clientNote qui porte sur
  /// toute la commande. Renseignable uniquement si le produit a
  /// allowSpecialInstructions=true au moment de la commande (voir
  /// ProductOptionsModal.tsx côté Client). Affiché sur le ticket de
  /// préparation, voir apps/pro/src/services/printLabel.ts.
  specialInstructions String? @map("special_instructions")

  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String      @map("order_id")
  status      OrderStatus
  changedAt   DateTime    @default(now()) @map("changed_at")
  changedBy   String?     @map("changed_by")
  note        String?
  
  order       Order       @relation(fields: [orderId], references: [id])
}

// ==================== SUIVI GPS ====================

model TrackingEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  riderId   String   @map("rider_id")
  lat       Decimal  @db.Decimal(10,8)
  lng       Decimal  @db.Decimal(11,8)
  timestamp DateTime @default(now())
  
  order     Order    @relation(fields: [orderId], references: [id])
}

// ==================== GAIN LIVREUR ====================

model Earning {
  id          String      @id @default(uuid())
  riderId     String      @map("rider_id")
  orderId     String      @map("order_id")
  amount      Decimal     @db.Decimal(8,2)
  type        EarningType
  status      EarningStatus @default(PENDING)
  /// Id du virement Stripe Connect si ce gain a été payé automatiquement
  /// (status passe directement à PAID dans ce cas, sans jamais transiter
  /// par Rider.balance/Withdrawal — voir orders/[orderId]/status/route.ts).
  stripeTransferId String?  @map("stripe_transfer_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  paidAt      DateTime?   @map("paid_at")
  
  rider       Rider       @relation(fields: [riderId], references: [id])
}

model Withdrawal {
  id          String   @id @default(uuid())
  riderId     String   @map("rider_id")
  amount      Decimal  @db.Decimal(8,2)
  status      WithdrawalStatus @default(PENDING)
  iban        String
  /// Id du virement Stripe Connect réel une fois le retrait traité (correctif
  /// du 23/09/2026 -- avant ça, un retrait restait PENDING indéfiniment sans
  /// jamais déclencher de vrai virement, voir riders/me/withdrawals/route.ts).
  /// Même convention que Order.proTransferId/riderTransferId : null tant que
  /// le virement n'a pas encore réussi.
  stripeTransferId String? @map("stripe_transfer_id")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  rider       Rider    @relation(fields: [riderId], references: [id])
}

// ==================== RÉCLAMATIONS / SIGNALEMENTS ====================

/// Réclamation (Client) ou signalement de problème (Livreur, Pro) rattaché
/// à une commande. Un seul modèle pour les 3 cas plutôt que 3 tables
/// distinctes : la structure est identique (qui signale, quoi, message,
/// suivi par l'admin) et seul `reporterRole` change -- ça simplifie
/// grandement la page admin unique "Réclamations" qui doit tout centraliser
/// (voir apps/admin/src/pages/ReportsPage.tsx). `photoUrl` est optionnel et
/// seulement proposé côté Client/Livreur pour l'instant (apps disposant
/// déjà d'un client Supabase Storage -- voir uploadsApi.ts de ces apps).
model OrderReport {
  id            String              @id @default(uuid())
  orderId       String              @map("order_id")
  userId        String              @map("user_id")
  reporterRole  UserRole            @map("reporter_role")
  category      OrderReportCategory
  message       String              @db.Text
  photoUrl      String?             @map("photo_url")
  status        OrderReportStatus   @default(OPEN)
  adminReply    String?             @db.Text @map("admin_reply")
  repliedAt     DateTime?           @map("replied_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  order         Order               @relation(fields: [orderId], references: [id])
  user          User                @relation(fields: [userId], references: [id])

  @@map("order_reports")
}

// ==================== COLIS EXPRESS ====================

/// Livraison de colis à la demande d'un Pro (pas un Client) -- voir la
/// proposition "Colis Express" envoyée à Krys le 19/09/2026, et sa décision
/// du même jour sur le périmètre (gabarit S/M scooter/véhicule léger, pros
/// et clients déjà inscrits à terme -- mais MVP limité à l'espace Pro pour
/// l'instant, zone tout le Golfe, facturation directe par course).
///
/// Volontairement une table séparée de Order/OrderItem plutôt qu'une
/// extension de celles-ci : Order suppose toujours un clientId (compte
/// Client qui achète) et des OrderItem liés à un vrai Product du catalogue
/// d'un Pro -- deux hypothèses fausses ici, le payeur est le Pro lui-même et
/// il n'y a ni client destinataire avec compte ni produit, juste un nom, un
/// téléphone et un colis. Ne pas toucher à Order limite le risque sur les
/// commandes repas déjà en production. Réutilise en revanche Pro/Rider/
/// Address tels quels, et un cycle de statuts calqué sur OrderStatus (sans
/// PREPARING/READY, qui n'ont pas de sens sans préparation en cuisine).
model ParcelOrder {
  id              String            @id @default(uuid())
  parcelNumber    String            @unique @map("parcel_number")
  proId           String            @map("pro_id")
  riderId         String?           @map("rider_id")
  fromAddressId   String            @map("from_address_id")
  toAddressId     String            @map("to_address_id")

  /// Destinataire du colis -- pas un compte Client, juste les coordonnées
  /// nécessaires au livreur pour la remise (voir raisonnement ci-dessus).
  recipientName   String            @map("recipient_name")
  recipientPhone  String            @map("recipient_phone")

  /// "Petits colis transportables par scooter ou véhicule léger" (décision
  /// Krys, 19/09/2026) -- pas de L/XL pour l'instant.
  size            ParcelSize        @default(S)
  /// Instruction libre du Pro pour le livreur (ex: "sonner à l'interphone
  /// 3B", "fragile") -- équivalent de Order.clientNote.
  instructions    String?
  /// Photo du colis ajoutée par le Pro (19/09/2026, demande de Krys) --
  /// bucket Supabase Storage dédié "parcel-photos" (À CRÉER manuellement,
  /// public, même principe que "product-images"), chemin "{proId}/{id}.ext".
  /// Pas encore affichée côté app Livreur -- ce volet n'existe pas encore
  /// pour Colis Express (voir riders/me/available-orders, qui ne traite que
  /// Order pour l'instant) ; ce champ est ajouté en préparation, prêt à être
  /// affiché dès que cet écran Livreur sera construit.
  photoUrl        String?           @map("photo_url")

  status          ParcelOrderStatus @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING) @map("payment_status")

  deliveryFee     Decimal           @db.Decimal(6,2) @map("delivery_fee")
  /// Supplément "express" (priorité sur une tournée groupée plutôt
  /// qu'attente du prochain passage) -- voir proposition, section
  /// Tarification. 0 si non applicable.
  expressFee      Decimal           @default(0) @db.Decimal(6,2) @map("express_fee")
  total           Decimal           @db.Decimal(6,2)

  riderEarnings     Decimal         @db.Decimal(6,2) @map("rider_earnings")
  platformEarnings  Decimal         @db.Decimal(6,2) @map("platform_earnings")

  /// Facturation directe par course (décision Krys, 19/09/2026) -- débitée
  /// sur Pro.stripeCustomerId (le Customer Stripe de l'abonnement du Pro,
  /// PAS son compte Connect stripeAccountId qui sert lui à RECEVOIR de
  /// l'argent). Suppose qu'un moyen de paiement par défaut existe déjà sur
  /// ce Customer -- à vérifier avant de coder le débit lui-même.
  stripePaymentIntentId String?     @map("stripe_payment_intent_id")
  cardBrand       String?           @map("card_brand")
  cardLast4       String?           @map("card_last_4")

  /// Virement Stripe Connect réel vers le livreur une fois la demande
  /// DELIVERED (finition du workflow Livreur, 23/09/2026 -- voir
  /// parcel-orders/status/route.ts). Même convention que
  /// Order.riderTransferId : null tant que le virement n'a pas encore réussi.
  riderTransferId String?           @map("rider_transfer_id")
  /// Même mécanisme que Order.riderNotifiedAt (voir riderNotifications.ts) --
  /// évite de renotifier les livreurs à proximité à chaque poll de
  /// riders/me/available-parcel-orders tant qu'aucun nouveau n'est entré
  /// dans le rayon.
  riderNotifiedAt DateTime?         @map("rider_notified_at")

  placedAt        DateTime          @default(now()) @map("placed_at")
  riderAssignedAt DateTime?         @map("rider_assigned_at")
  pickedUpAt      DateTime?         @map("picked_up_at")
  deliveredAt     DateTime?         @map("delivered_at")
  cancelledAt     DateTime?         @map("cancelled_at")

  pro             Pro               @relation(fields: [proId], references: [id])
  rider           Rider?            @relation(fields: [riderId], references: [id])
  fromAddress     Address           @relation("ParcelFromAddress", fields: [fromAddressId], references: [id])
  toAddress       Address           @relation("ParcelToAddress", fields: [toAddressId], references: [id])
}

enum ParcelOrderStatus {
  PENDING
  /// Paiement confirmé (Stripe) -- seulement à partir de ce statut qu'une
  /// course doit apparaître comme disponible pour les livreurs. Pas encore
  /// utilisé tant que le débit Stripe n'est pas câblé (19/09/2026) -- voir
  /// la proposition, section 5.
  CONFIRMED
  RIDER_ASSIGNED
  PICKED_UP
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

enum ParcelSize {
  S
  M
}

// ==================== CONTACT SITE VITRINE ====================

/// Message envoyé via le widget "Nous contacter" du site vitrine (voir
/// apps/www ContactWidget.tsx et POST /api/contact) -- PAS de relation User
/// contrairement à OrderReport : ce sont des visiteurs anonymes, pas
/// forcément des comptes existants sur la plateforme. Géré et archivé
/// entièrement depuis l'admin (voir apps/admin ContactMessagesPage.tsx),
/// avec réponse envoyée par email au visiteur sans jamais passer par la
/// messagerie personnelle de l'équipe.
model ContactMessage {
  id          String               @id @default(uuid())
  name        String
  email       String
  /// Libre plutôt qu'un enum -- "Aide" / "Bug" / "Erreur" / "Demande directe"
  /// définis côté API (voir CONTACT_TYPES dans contact/route.ts), pour
  /// pouvoir ajuster ce libellé sans migration.
  type        String
  /// Application d'origine du message (23/09/2026, demande explicite de
  /// Krys : bulle "Nous contacter" ajoutée aux apps Client/Pro/Livreur, sur
  /// le modèle de celle du site vitrine) -- "www" = widget historique du
  /// site vitrine (ContactWidget.tsx dans apps/www), sinon "client"/"pro"/
  /// "livreur" selon l'app connectée qui a envoyé le message. Permet de
  /// filtrer/identifier d'un coup d'œil dans l'admin (voir
  /// ContactMessagesPage.tsx) sans avoir à deviner depuis le nom/email.
  /// Libre plutôt qu'un enum, même raisonnement que `type` ci-dessus.
  source      String               @default("www")
  subject     String
  message     String               @db.Text
  status      OrderReportStatus    @default(OPEN)
  adminReply  String?              @db.Text @map("admin_reply")
  repliedAt   DateTime?            @map("replied_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("contact_messages")
}

// ==================== VISITES / STATISTIQUES DE FRÉQUENTATION ====================

/// Un événement de visite -- une ligne par "ouverture" d'app (WWW: une par
/// page vue, pour permettre le calcul des pages les plus visitées ; CLIENT/
/// PRO/LIVREUR: une par lancement de l'app, ces apps étant à page unique
/// côté navigation) -- voir POST /api/analytics/visit (public, pas d'auth)
/// et GET /api/admin/analytics/visits (agrégation admin). Entièrement
/// anonyme par conception (voir la question posée à l'utilisateur lors de
/// la conception de cette fonctionnalité) : aucun lien vers un compte
/// Client/Pro/Rider, `sessionId` est un identifiant aléatoire généré
/// côté client (sessionStorage pour WWW, un identifiant par lancement pour
/// les apps mobiles), jamais un identifiant utilisateur.
///
/// "Visite" = COUNT(DISTINCT sessionId) sur la période (voir la réponse
/// "par session" donnée à la question posée lors de la conception) --
/// distinct du nombre de lignes ici, qui correspond aux pages vues pour WWW.
model AppVisit {
  id         String    @id @default(uuid())
  app        AppSource
  sessionId  String    @map("session_id")
  /// Chemin de la page vue -- uniquement significatif pour WWW (site
  /// multi-pages) ; les 3 apps authentifiées envoient un chemin logique fixe
  /// (ex: "app_open") plutôt que null, pour rester cohérent dans les
  /// agrégations sans cas particulier.
  path       String?
  /// "mobile" | "desktop" | "unknown" -- déduit du User-Agent côté serveur
  /// si non fourni par le client (voir POST /api/analytics/visit).
  deviceType String?   @map("device_type")
  referrer   String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([app, createdAt])
  @@index([sessionId])
  @@map("app_visits")
}

// ==================== VILLES ACTIVÉES (LANCEMENT PROGRESSIF) ====================

/// Villes/communes sur lesquelles la plateforme accepte des commandes.
/// Distinct de DeliveryZone (qui définit le rayon de livraison propre à
/// CHAQUE commerçant) : ServiceCity est un interrupteur global, utilisé
/// pour ouvrir le service progressivement commune par commune (Sainte-
/// Maxime, puis Saint-Tropez, Cogolin...) plutôt que sur tout le Golfe en
/// même temps au lancement. Rattachée à Address.city par un rapprochement
/// texte normalisé (voir normalizeCity() dans orders/route.ts), pas par une
/// relation stricte : Address.city reste un champ libre, on ne voulait pas
/// bloquer la création d'adresse si une ville n'a pas encore été ajoutée ici.
/// N'a AUCUN effet tant que le réglage GlobalSetting
/// "capacity.city_gating_enabled" n'est pas activé depuis Admin > Zones &
/// Capacité (voir CapacityPage.tsx côté admin).
model ServiceCity {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(false) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  /// Extension SEO (23/08/2026, audit SEO/GEO) : distincte d'isActive à
  /// dessein. isActive pilote l'ouverture des COMMANDES (voir le commentaire
  /// au-dessus du modèle) ; seoIndexable pilote uniquement si la page
  /// /livraison/[slug] correspondante est indexable par les moteurs. Une
  /// ville peut avoir sa page publiée en "bientôt disponible" (donc
  /// seoIndexable=false) avant même d'être active, ou être active en
  /// interne sans encore avoir de contenu suffisant pour mériter d'être
  /// indexée -- les deux réglages doivent pouvoir varier indépendamment.
  seoIndexable  Boolean @default(false) @map("seo_indexable")
  /// Slug d'URL (/livraison/[seoSlug]) -- distinct de `name` pour ne jamais
  /// casser un lien déjà indexé si le nom affiché change (ex: correction
  /// d'accent) ; normalisé une seule fois à la création, jamais recalculé
  /// automatiquement depuis `name`.
  seoSlug       String? @unique @map("seo_slug")
  /// Paragraphe d'intro affiché en haut de la page ville -- texte réel
  /// rédigé pour cette commune, jamais généré automatiquement à partir d'un
  /// gabarit (voir la mise en garde dans le cadrage SEO/GEO contre le
  /// contenu quasi dupliqué d'une ville à l'autre).
  seoIntro      String? @map("seo_intro")
  lat           Decimal? @db.Decimal(9, 6)
  lng           Decimal? @db.Decimal(9, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_cities")
}

// ==================== PARAMÈTRES ADMIN ====================

model GlobalSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String   @map("updated_by")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== ADMIN ====================

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  permissions Json
  department  String?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== HORAIRES D'OUVERTURE ====================

model OpeningHours {
  id        String   @id @default(uuid())
  proId     String   @map("pro_id")
  dayOfWeek Int      @map("day_of_week")
  openTime  String   @map("open_time")
  closeTime String   @map("close_time")
  isClosed  Boolean  @default(false) @map("is_closed")
  
  pro       Pro      @relation(fields: [proId], references: [id])
}

// ==================== AVIS ====================

/// Avis client sur une commande -- REDESIGN : chaque cible (commercant /
/// livreur / plateforme) a sa PROPRE note et son PROPRE commentaire,
/// totalement independants les uns des autres. Le client choisit librement
/// ce qu'il note (uniquement le livreur, uniquement le commercant, tout,
/// ou rien de tout ca s'il ne note que des produits -- voir ProductReview
/// ci-dessous, gere separement car une commande peut contenir plusieurs
/// produits). Avant ce redesign, un seul champ `comment` etait affiche tel
/// quel sous les 3 cibles a la fois, ce qui n'avait pas de sens (un avis sur
/// le gout d'un plat n'est pas un avis sur le livreur).
///
/// proId/riderId restent toujours renseignes depuis la commande (meme si le
/// client n'a pas note cette cible) -- c'est la presence de proRating /
/// riderRating / platformRating (non-null) qui indique qu'un avis a
/// effectivement ete laisse pour cette cible precise. Une ligne Review
/// n'est creee que si au moins une des 3 cibles est notee ; sinon (avis
/// uniquement sur des produits) seules des lignes ProductReview existent.
model Review {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  proId       String?  @map("pro_id")
  riderId     String?  @map("rider_id")
  orderId     String   @unique @map("order_id")

  /// Avis sur le COMMERCANT -- independant du livreur/de la plateforme.
  proRating    Int?     @map("pro_rating")
  proComment   String?  @map("pro_comment")
  proReply     String?  @map("pro_reply")
  proRepliedAt DateTime? @map("pro_replied_at")

  /// Avis sur le LIVREUR de cette commande -- independant du commercant/de la plateforme.
  riderRating  Int?     @map("rider_rating")
  riderComment String?  @map("rider_comment")

  /// Avis sur l'application Do You Geckoo elle-meme (experience globale,
  /// pas un commercant ni un livreur en particulier).
  platformRating  Int?    @map("platform_rating")
  platformComment String? @map("platform_comment")

  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])
  pro    Pro?   @relation(fields: [proId], references: [id])
  rider  Rider? @relation(fields: [riderId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
}

/// Avis sur un PRODUIT precis achete -- entierement independant de Review
/// ci-dessus (pas de FK obligatoire) : le client peut noter un produit sans
/// rien dire du commercant/livreur, ou l'inverse. Une ligne par produit
/// note (une commande pouvant contenir plusieurs produits differents),
/// contrairement a l'ancien Review.productRating qui etait un simple
/// scalaire par commande, jamais reellement exploitable ni rattache a un
/// produit precis. Alimente la note affichee sur la fiche du produit
/// (Product.rating/ratingCount, voir POST /api/orders/[orderId]/review qui
/// recalcule ces agregats a chaque nouvel avis).
model ProductReview {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  orderId   String   @map("order_id")
  productId String   @map("product_id")

  rating    Int
  comment   String?
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")

  client  Client  @relation(fields: [clientId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  /// Un seul avis par produit et par commande (un produit peut apparaitre
  /// plusieurs fois dans une commande via des lignes d'options differentes
  /// -- OrderItem -- mais un seul avis global par produit suffit).
  @@unique([orderId, productId])
}

/// Compteurs de rate limiting par IP (23/09/2026, suite a l'audit securite
/// demande par Krys) -- protege les endpoints publics sensibles (login,
/// signup, forgot-password, contact) contre le bourrinage/spam. Une ligne
/// par cle "route:ip", remise a zero automatiquement a l'expiration de
/// resetAt (voir lib/rateLimit.ts -- upsert atomique via SQL brut, jamais
/// via Prisma Client classique ici, pour eviter toute race condition entre
/// deux requetes concurrentes de la meme IP). Aucune relation avec le reste
/// du schema : purement technique, jamais expose via l'API.
model RateLimitHit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime @map("reset_at")

  @@map("rate_limit_hits")
}

// ==================== PROSPECTION COMMERCIALE ====================

/// Restaurants/commerces du Golfe de Saint-Tropez qui ne sont PAS encore
/// Pro sur la plateforme -- ajout du 26/09/2026, demande de Krys : liste de
/// prospection pour démarcher de nouveaux commerçants directement depuis
/// Admin. Liste de départ constituée par recherche web (site officiel du
/// commerce, office de tourisme, mairie -- PAS d'extraction de la base
/// Uber Eats, qui n'expose aucun email de contact public et dont les
/// conditions d'utilisation interdisent ce type de collecte pour un usage
/// commercial concurrent), voir lib/prospectSeedData.ts. Krys complète/
/// corrige ensuite directement les lignes depuis la page admin (email
/// manquant, mauvais numéro...).
model Prospect {
  id           String      @id @default(uuid())
  businessName String      @map("business_name")
  city         String
  category     ProCategory @default(AUTRE)
  email        String?
  phone        String?
  websiteUrl   String?     @map("website_url")
  /// Lien vers la fiche Google Maps/Google Business -- Krys s'en sert pour
  /// vérifier rapidement le commerce avant d'envoyer un mail.
  googleMapsUrl String?    @map("google_maps_url")
  notes        String?

  /// null = inconnu (pas encore vérifié), true/false = vérifié par recherche
  /// web (site officiel/réseaux sociaux/office de tourisme du commerce --
  /// jamais consulté depuis Uber Eats/Deliveroo/Just Eat, voir
  /// app/api/admin/prospects/annotate/route.ts). Ajout du 26/09/2026 --
  /// Krys veut repérer d'un coup d'œil qui prospecter, et retirer ceux qui
  /// ne font pas de vente à emporter.
  offersTakeaway     Boolean? @map("offers_takeaway")
  /// true seulement si LE COMMERCE LUI-MÊME affiche/mentionne Uber Eats sur
  /// ses propres canaux (site, réseaux sociaux) -- jamais déduit d'une
  /// consultation de la plateforme Uber Eats elle-même. null/false = aucune
  /// mention trouvée, pas une confirmation d'absence.
  advertisesUberEats Boolean? @map("advertises_uber_eats")

  /// D'où vient cette ligne : "recherche_web" (import initial du
  /// 26/09/2026) ou "manuel" (ajoutée/corrigée à la main depuis Admin).
  source       String      @default("manuel")

  /// Suivi de l'envoi du mail de prospection (voir
  /// app/api/admin/prospects/[prospectId]/send-email/route.ts). Un seul
  /// mail par prospect à la fois -- renvoyer écrase juste les dates
  /// précédentes, on ne garde pas d'historique multi-envois pour l'instant.
  prospectingEmailSentAt    DateTime? @map("prospecting_email_sent_at")
  /// Identifiant du message retourné par Resend au moment de l'envoi --
  /// c'est LA clé utilisée par le webhook Resend (voir
  /// app/api/webhooks/resend/route.ts) pour retrouver ce Prospect quand un
  /// événement "email.opened"/"email.clicked" arrive. Resend n'accepte pas
  /// de métadonnée personnalisée sur un envoi simple, donc pas d'autre
  /// moyen de faire le lien.
  prospectingEmailId        String?   @map("prospecting_email_id")
  prospectingEmailOpenedAt  DateTime? @map("prospecting_email_opened_at")
  prospectingEmailClickedAt DateTime? @map("prospecting_email_clicked_at")

  /// Rempli automatiquement dès qu'un compte Pro est créé (signup) avec le
  /// même email que ce prospect (voir app/api/auth/signup/route.ts) --
  /// c'est le signal "objectif atteint" que Krys veut voir sur la page.
  /// Pas de vraie relation Prisma vers Pro : Pro n'existe pas forcément
  /// encore au moment de la création du Prospect, et on ne veut surtout pas
  /// qu'une suppression de Pro entraîne la suppression de l'historique de
  /// prospection.
  convertedAt   DateTime? @map("converted_at")
  convertedProId String?  @map("converted_pro_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("prospects")
}
