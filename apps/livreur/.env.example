# URL de l'API backend (apps/api). En dev local sur simulateur, localhost
# fonctionne. Sur un appareil physique, remplacer par l'IP locale de votre
# machine sur le réseau Wi-Fi (ex: http://192.168.1.42:3000).
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Supabase — nécessaires pour l'upload direct des images (Storage, photo de
# profil) et, à terme, les souscriptions Realtime (postgres_changes).
# PAS utilisées pour l'auth, qui passe entièrement par l'API.
EXPO_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
