{
  "expo": {
    "name": "Do You Geckoo",
    "slug": "golfeexpress-client",
    "scheme": "golfeexpress-client",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#2ECC71"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.golfeexpress.client",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Do You Geckoo utilise votre position pour vous proposer les commerçants les plus proches et faciliter la sélection de votre adresse de livraison."
      }
    },
    "android": {
      "package": "fr.golfeexpress.client"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Do You Geckoo",
      "shortName": "Do You Geckoo",
      "themeColor": "#2ECC71",
      "backgroundColor": "#2ECC71",
      "display": "standalone",
      "description": "Livraison locale du Golfe de Saint-Tropez"
    },
    "plugins": []
  }
}
