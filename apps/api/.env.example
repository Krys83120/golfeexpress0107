# ==================== SUPABASE ====================
# Récupérables dans Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Clé service_role — NE JAMAIS exposer côté client, utilisée uniquement côté serveur
# (création d'utilisateurs admin, bypass RLS pour les opérations système, trigger sync)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ==================== BASE DE DONNÉES (Prisma) ====================
# Connection string Supabase Postgres "Transaction" (pooler, port 6543) — pour Prisma Client en prod/serverless
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connection string "Session" (port 5432, direct) — requise par Prisma Migrate (DDL)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ==================== STRIPE ====================
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret du webhook "Votre compte" (payment_intent.*), voir
# apps/api/src/app/api/webhooks/stripe/route.ts
STRIPE_WEBHOOK_SECRET="whsec_..."
# Signing secret du webhook "Comptes connectés" (account.updated) — DIFFÉRENT
# du précédent, voir apps/api/src/app/api/webhooks/stripe-connect/route.ts
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# Stripe Connect — URLs de retour après l'onboarding bancaire (formulaire
# hébergé par Stripe). Optionnelles : par défaut pointent déjà vers
# pro.doyougeckoo.fr / livreur.doyougeckoo.fr (voir lib/stripeConnect.ts).
# STRIPE_CONNECT_RETURN_URL_PRO="https://pro.doyougeckoo.fr"
# STRIPE_CONNECT_RETURN_URL_RIDER="https://livreur.doyougeckoo.fr"

# ==================== WEB PUSH (notifications livreurs) ====================
# Paire de clés générée UNE SEULE FOIS pour ce projet (ex: `npx web-push
# generate-vapid-keys`) -- pas des identifiants d'un service tiers à
# protéger, juste une paire cryptographique propre à cette fonctionnalité.
# La clé publique doit aussi être collée dans apps/livreur/.env.local sous
# EXPO_PUBLIC_VAPID_PUBLIC_KEY (même valeur, nécessaire côté navigateur).
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_CONTACT_EMAIL="contact@doyougeckoo.fr"

# ==================== APPLICATION ====================
# URL publique de l'API (utile pour générer des liens absolus, ex: emails)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Environnement ("development" | "production")
NODE_ENV="development"
