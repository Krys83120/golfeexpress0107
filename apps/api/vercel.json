{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --no-audit --no-fund --ignore-scripts",
  "buildCommand": "npx prisma generate --schema=./prisma/schema.prisma && npm run build --workspace=apps/api",
  "crons": [
    {
      "path": "/api/cron/reset-product-availability",
      "schedule": "0 1 * * *"
    }
  ]
}
